{
  "name": "chat-simpapp-api",
  "private": true,
  "description": "Servidor de Chat SimpApp en Cloudflare Workers (reemplaza las Cloud Functions)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply chat-simpapp --remote"
  },
  "dependencies": {
    "geofire-common": "^6.0.0",
    "jose": "^6.2.18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
